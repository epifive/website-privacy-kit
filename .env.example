# ─────────────────────────────────────────────────────────────────────────────
# EpiFive Website Privacy Kit environment variables
#
# `npm run setup` writes .env.local with a master key and the job secrets; the
# web installer (first visit) writes the database choice to storage/config.json.
#
# Use the variables below for Docker, read-only hosting or advanced setups.
# Put them in `.env.local` (or set them in your hosting panel).
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on (server.js / npm start)
PORT=3000

# Public address of this installation, used when "Site URL" is empty in the admin panel.
# It is also the address in your banner snippet, so use https://.
# SITE_URL=https://privacy.example.com

# Where config.json, the SQLite database and uploads (logos) are stored.
# STORAGE_DIR=/var/lib/privacykit

# Number of reverse proxies in front of the app that add X-Forwarded-For. Used to find
# the real visitor IP for rate limits (widget API, sign-in, rights-request form).
# Default 1: Nginx, Apache/Passenger (cPanel) or Vercel. Use 2 for Cloudflare in front of Nginx.
# TRUSTED_PROXY_HOPS=1

# Master key (32 bytes = 64 hex characters). REQUIRED in production: the app refuses to start
# without it. It never encrypts data directly: it wraps the data keys stored in the database
# (envelope encryption, src/lib/secrets.ts). Keep it out of the database and its backups, and
# keep a copy in your password manager. Outside production a key is created in
# STORAGE_DIR/master.key on first use.
#   node scripts/keys.mjs generate          new key
#   node scripts/keys.mjs status            which master key wrapped the stored keys
#   WPK_MASTER_KEY_OLD=old WPK_MASTER_KEY=new node scripts/keys.mjs rewrap    rotate the master key
#   node scripts/keys.mjs rotate-org <id|all>                                  new data key version
# WPK_MASTER_KEY=
# WPK_MASTER_KEY_FILE=/etc/privacykit/master.key   # alternative: read the key from a file (mode 600)

# Rights requests (/p/{org}/rights). The master key above also encrypts request details
# and attachments (stored in STORAGE_DIR/rights/). Reminders at T-7, T-1 and overdue are
# sent when this endpoint is called, e.g. twice a day from cron:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/v1/cron/rights-reminders
# CRON_SECRET=           # at least 16 characters
# The same secret runs the breach timer reminders (every 15 minutes; CERT-In has a 6-hour window)
# and the daily retention job (periodic erasure tasks, due/overdue and pre-erasure notice reminders):
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/v1/cron/breach-timers
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/v1/cron/retention-reminders
# Consent-record retention purge (deletes records older than the organisation setting, never
# younger than one year; leaves a checkpoint tombstone and an audit row). Separate secret on purpose.
# Dry run without ?apply=1:
#   curl -X POST -H "Authorization: Bearer $WPK_MAINTENANCE_SECRET" "https://your-site/api/v1/maintenance/consent-purge?apply=1"
# WPK_MAINTENANCE_SECRET= # at least 16 characters, different from CRON_SECRET
# Cloudflare Turnstile keys are set in Admin -> Settings -> Banner & privacy page.
# WPK_TURNSTILE=off      # turn Turnstile off (development, automated tests)
# WPK_MAIL_CONSOLE=1     # without SMTP, print emails to the server log (development/tests only)

# All scheduled jobs in one call every 15 minutes: see scripts/cron.md.
#   */15 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-site/api/v1/cron/run
# Platform log retention in days (security log, mail log, processed webhooks): default 400,
# never less than 365 (DPDP Rules 6(1)(e), 8(3)). Purged by /api/v1/maintenance/log-purge.
# WPK_LOG_RETENTION_DAYS=400

# Security
# WPK_ALLOWED_ORIGINS=https://privacy.example.com   # extra origins allowed to submit forms (CSRF check); SITE_URL is always allowed
# WPK_INSECURE_COOKIES=1    # plain-HTTP production only (LAN test); never on the internet
# WPK_ADMIN_2FA=off         # automated tests only: administrators without two-step verification

# Database — overrides storage/config.json when set.
# Either one connection URL (cloud providers give you this)…
# DATABASE_URL=mysql://user:password@host:3306/privacykit?ssl=true
# …or separate values:
# DB_DRIVER=mysql            # mysql or sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=privacykit
# DB_USER=privacykit
# DB_PASSWORD=secret
# DB_SSL=true                # required by TiDB Cloud, Aiven, DigitalOcean and most cloud MySQL
# DB_FILE=database.sqlite    # SQLite only, relative to STORAGE_DIR
# MySQL least privilege (scripts/mysql-grants.sql): the app runs as DB_USER (no DDL; insert-only
# tables are SELECT/INSERT only); migrations run on a short-lived connection as the schema owner,
# and the retention purges as the maintenance user.
# DB_MIGRATE_USER=wpk_owner
# DB_MIGRATE_PASSWORD=
# DB_MAINT_USER=wpk_maint
# DB_MAINT_PASSWORD=

# Encrypted nightly backups (scripts/backup.sh): age public key, optional S3/Spaces upload.
# AGE_RECIPIENT=age1...
# BACKUP_DIR=/var/backups/privacykit
# BACKUP_S3_URI=s3://my-bucket/privacykit/
# BACKUP_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Create (or promote) an administrator without the web installer.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Administrator

# Fill an empty database with a demo organisation (a clinic with a website, notice,
# requests, a breach and 45 days of consent records). Needs an administrator.
# DEMO_SEED=true

# Skip the web installer (when you configure the database with the variables above
# and have already run the installer once against that database).
# APP_INSTALLED=true

# Keep Server Action ids stable across multiple servers / rebuilds (optional).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Demo mode: the admin panel and the customer dashboard are read-only. Use this for a
# public live demo.
# DEMO_MODE=true
